#!/usr/bin/env zsh
set -euo pipefail

read -r -d '' USAGE <<'EOF' || true
process-issues — loop over approved GitHub issues and process them with OpenCode.

Issues are processed in project board order (top = highest priority).
If the highest-priority issue is blocked, the loop waits (polling every
10 minutes) until it is unblocked — lower-priority issues are not
processed because they may depend on it.

Usage:
  ./process-issues [--dry-run] [--pick] [--verbose] [--issue N] [--model MODEL] [--poll MINUTES]

Options:
  --help          Show this help message and exit.
  --dry-run       List issues that would be processed without spawning agents.
  --pick          Print the next eligible issue (number\ttitle\tblocked?) and exit.
  --verbose       Print diagnostic output to stderr (off by default).
  --issue N       Process only issue #N (skip the automatic selection).
  --model MODEL   Model to use (default: portkey/@vertex-ai/anthropic.claude-sonnet-4-6).
  --poll MINUTES  Poll interval when blocked (default: 10).

Requires: A GitHub Project board owned by the repo owner (t1) linked to this repo.
Set the project number below.
EOF

PROJECT_OWNER="t1"
PROJECT_NUMBER=1  # ← update after creating the project board

DRY_RUN=false
PICK_ONLY=false
VERBOSE=false
SPECIFIC_ISSUE=""
MODEL="portkey/@vertex-ai/anthropic.claude-sonnet-4-6"
POLL_MINUTES=10

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help)
            printf '%s\n' "$USAGE"
            exit 0
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --pick)
            PICK_ONLY=true
            shift
            ;;
        --verbose)
            VERBOSE=true
            shift
            ;;
        --issue)
            SPECIFIC_ISSUE="$2"
            shift 2
            ;;
        --model)
            MODEL="$2"
            shift 2
            ;;
        --poll)
            POLL_MINUTES="$2"
            shift 2
            ;;
        *)
            echo "Unknown option: $1" >&2
            printf '%s\n' "$USAGE" >&2
            exit 1
            ;;
    esac
done

# Diagnostic output helper — only prints when --verbose is set.
verbose() { [[ "$VERBOSE" == "true" ]] && echo "$@" >&2 || true; }

# Update plugins before starting (same as ./oc wrapper).
bun update tdder superpowers --cwd ~/.cache/opencode --silent 2>/dev/null || true

# Fetch issues from the project board in position order.
# Returns JSON array of {number, title, labels, state} sorted by board position.
fetch_board_issues() {
    gh api graphql -f query='
        query($owner: String!, $number: Int!) {
            user(login: $owner) {
                projectV2(number: $number) {
                    items(first: 50) {
                        nodes {
                            content {
                                ... on Issue {
                                    number
                                    title
                                    state
                                    labels(first: 10) {
                                        nodes { name }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ' -f owner="$PROJECT_OWNER" -F number="$PROJECT_NUMBER" \
    --jq '[
        .data.user.projectV2.items.nodes[]
        | select(.content.number != null)
        | {
            number: .content.number,
            title: .content.title,
            state: .content.state,
            labels: [.content.labels.nodes[].name]
        }
    ]' 2>/dev/null || echo "[]"
}

pick_next_issue() {
    if [[ -n "$SPECIFIC_ISSUE" ]]; then
        # Verify the specific issue is approved and not blocked.
        verbose "--- Picking issue #${SPECIFIC_ISSUE} (explicitly requested) ---"
        local issue_json
        issue_json=$(gh issue view "$SPECIFIC_ISSUE" --json number,title,labels 2>/dev/null) || {
            echo "  Issue #$SPECIFIC_ISSUE not found." >&2
            return 1
        }
        local labels title
        labels=$(echo "$issue_json" | jq -r '[.labels[].name] | join(",")')
        title=$(echo "$issue_json" | jq -r '.title')
        verbose "  #${SPECIFIC_ISSUE}: ${title}  [${labels}]"
        if [[ "$labels" != *"approved"* ]]; then
            echo "  -> Skipped: not labeled 'approved'." >&2
            return 1
        fi
        if [[ "$labels" == *"blocked"* ]]; then
            echo "  -> Blocked: answer the question first." >&2
            echo "$issue_json" | jq -r '"\(.number)\t\(.title)"'
            return 2
        fi
        verbose "  -> Selected."
        echo "$issue_json" | jq -r '"\(.number)\t\(.title)"'
        return 0
    fi

    verbose "--- Fetching project board ---"
    local board_issues
    board_issues=$(fetch_board_issues)

    if [[ "$board_issues" == "[]" || -z "$board_issues" ]]; then
        echo "  No issues on the project board." >&2
        return 1
    fi

    local total
    total=$(echo "$board_issues" | jq 'length')
    verbose "  Found ${total} issue(s) on the board."

    # Log each open issue with its status and why it's eligible or not.
    echo "$board_issues" | jq -r '.[] | select(.state == "OPEN") | "\(.number)\t\(.title)\t\(.state)\t\(.labels | join(","))"' | \
    while IFS=$'\t' read -r num title state labels; do
        local reason=""
        if [[ "$labels" != *"approved"* ]]; then
            reason="not approved"
        elif [[ "$labels" == *"blocked"* ]]; then
            reason="blocked"
        else
            reason="eligible"
        fi
        verbose "  #${num}: ${title}  [${labels:-no labels}] -> ${reason}"
    done

    # Filter to open, approved issues (in board order).
    local eligible
    eligible=$(echo "$board_issues" | jq -r '
        [.[] | select(.state == "OPEN" and (.labels | index("approved")))]
    ')

    local eligible_count
    eligible_count=$(echo "$eligible" | jq 'length')
    if [[ "$eligible_count" -eq 0 ]]; then
        echo "  No eligible issues (open + approved) on the board." >&2
        return 1
    fi

    # Check the FIRST eligible issue. If it's blocked, wait.
    local first_labels first_number first_title
    first_number=$(echo "$eligible" | jq -r '.[0].number')
    first_title=$(echo "$eligible" | jq -r '.[0].title')
    first_labels=$(echo "$eligible" | jq -r '.[0].labels | join(",")')

    if [[ "$first_labels" == *"blocked"* ]]; then
        echo "  Highest-priority eligible issue #${first_number} (${first_title}) is blocked." >&2
        echo "${first_number}\t${first_title}"
        return 2
    fi

    verbose "  -> Picked #${first_number}: ${first_title} (highest priority, ${eligible_count} eligible)"
    echo "${first_number}\t${first_title}"
}

process_one_issue() {
    local issue_number="$1"
    local issue_title="$2"

    echo "=== Processing issue #${issue_number}: ${issue_title} ==="

    if [[ "$DRY_RUN" == "true" ]]; then
        echo "  [dry-run] Would spawn: opencode run for issue #${issue_number}"
        return 0
    fi

    # Build the prompt.
    local prompt="Load the process-issue skill. Work on issue #${issue_number} for the openapi-ui-next project. This is autonomous mode. After committing, push to trunk and wait for CI to pass."

    # Spawn a fresh OpenCode session.
    opencode run "$prompt" \
        --model "$MODEL" \
        --title "Issue #${issue_number}: ${issue_title}" \
        2>&1 | tee "/tmp/process-issue-${issue_number}.log"

    local exit_code=${pipestatus[1]}

    # Check outcome.
    local labels
    labels=$(gh issue view "$issue_number" --json labels --jq '[.labels[].name] | join(",")' 2>/dev/null || echo "")

    if [[ "$labels" == *"blocked"* ]]; then
        echo "  -> Issue #${issue_number} is BLOCKED. Check the issue for a question."
        return 0
    fi

    local state
    state=$(gh issue view "$issue_number" --json state --jq '.state' 2>/dev/null || echo "OPEN")

    if [[ "$state" == "CLOSED" ]]; then
        echo "  -> Issue #${issue_number} COMPLETED."
        return 0
    fi

    if [[ $exit_code -ne 0 ]]; then
        echo "  -> Issue #${issue_number}: session exited with code ${exit_code}." >&2
        return 1
    fi

    echo "  -> Issue #${issue_number}: session ended without closing the issue."
    return 0
}

list_all_eligible_issues() {
    local board_issues
    board_issues=$(fetch_board_issues)

    echo "$board_issues" | jq -r '
        [.[] | select(.state == "OPEN" and (.labels | index("approved")))]
        | .[]
        | "\(.number)\t\(.title)\t\(if (.labels | index("blocked")) then "BLOCKED" else "ready" end)"
    ' 2>/dev/null
}

# Main loop.
if [[ "$PICK_ONLY" == "true" ]]; then
    # Print the next eligible issue and exit.
    # Output format: number\ttitle\tblocked|ready
    line=$(pick_next_issue) && rc=0 || rc=$?
    if [[ $rc -eq 2 ]]; then
        issue_number=$(echo "$line" | cut -f1)
        issue_title=$(echo "$line" | cut -f2-)
        echo "${issue_number}\t${issue_title}\tblocked"
    elif [[ $rc -ne 0 ]]; then
        echo "No eligible issues." >&2
        exit 1
    else
        issue_number=$(echo "$line" | cut -f1)
        issue_title=$(echo "$line" | cut -f2-)
        echo "${issue_number}\t${issue_title}\tready"
    fi
    exit 0
elif [[ -n "$SPECIFIC_ISSUE" ]]; then
    # Process just the one specified issue.
    line=$(pick_next_issue) && rc=0 || rc=$?
    [[ $rc -ne 0 ]] && exit 1
    issue_number=$(echo "$line" | cut -f1)
    issue_title=$(echo "$line" | cut -f2-)
    process_one_issue "$issue_number" "$issue_title"
elif [[ "$DRY_RUN" == "true" ]]; then
    # In dry-run mode, list all board issues with their status.
    echo "Issues on project board (in priority order):"
    list_all_eligible_issues | while IFS=$'\t' read -r issue_number issue_title issue_status; do
        [[ -z "$issue_number" || "$issue_number" == "null" ]] && continue
        echo "  #${issue_number}: ${issue_title} [${issue_status}]"
    done
else
    # In real mode, pick one at a time (state changes after processing).
    while true; do
        line=$(pick_next_issue) && rc=0 || rc=$?
        if [[ $rc -eq 2 ]]; then
            # Top issue is blocked — wait for it to be unblocked.
            echo "Waiting ${POLL_MINUTES} minutes before re-checking..."
            sleep $((POLL_MINUTES * 60))
            continue
        elif [[ $rc -ne 0 ]]; then
            echo "No more eligible issues."
            break
        fi
        if [[ "$line" == "null"* || -z "$line" ]]; then
            echo "No more eligible issues."
            break
        fi
        issue_number=$(echo "$line" | cut -f1)
        issue_title=$(echo "$line" | cut -f2-)
        process_one_issue "$issue_number" "$issue_title" || {
            echo "Stopping due to error on issue #${issue_number}."
            break
        }
    done
fi

echo "Done."
